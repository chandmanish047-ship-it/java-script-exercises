<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Array Concatenation Example</title>
</head>
<body>

    <h1>Array Concatenation Result:</h1>
    <p id="output"></p>

    <script>
        // 1. Write the concat function without using array.join()
        function concat(arr) {
            let result = "";
            for (let i = 0; i < arr.length; i++) {
                result += arr[i];
            }
            return result;
        }

        // 2. Hardcode the array as specified
        const bandMembers = ['Johnny', 'DeeDee', 'Joey', 'Marky'];

        // 3. Call the function
        const concatenatedString = concat(bandMembers);
        document.getElementById("output").textContent = concatenatedString;
    </script>
</body>
</html>